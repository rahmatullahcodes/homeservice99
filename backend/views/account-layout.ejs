<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Home Service Account</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif; background: #f5f5f5; }
    
    .account-container { display: flex; min-height: 100vh; }
    
    .account-sidebar { 
      width: 250px; 
      background: white; 
      padding: 24px 0; 
      box-shadow: 2px 0 8px rgba(0,0,0,0.1); 
      overflow-y: auto;
    }
    
    .account-sidebar h3 { 
      padding: 0 20px; 
      margin-bottom: 16px; 
      font-size: 14px; 
      color: #999; 
      text-transform: uppercase; 
    }
    
    .account-nav-item { 
      display: block; 
      padding: 12px 20px; 
      color: #666; 
      text-decoration: none; 
      transition: all 0.2s; 
      border-left: 3px solid transparent; 
    }
    
    .account-nav-item:hover { 
      background: #f5f5f5; 
      color: #3b82f6; 
      padding-left: 24px; 
    }
    
    .account-nav-item.active { 
      background: #f0f9ff; 
      color: #3b82f6; 
      border-left-color: #3b82f6; 
      padding-left: 24px; 
    }
    
    .account-content { 
      flex: 1; 
      padding: 32px; 
      overflow-y: auto; 
    }
    
    .account-header { 
      margin-bottom: 32px; 
      display: flex; 
      justify-content: space-between; 
      align-items: center; 
    }
    
    .account-user-info h2 { 
      font-size: 24px; 
      margin-bottom: 4px; 
    }
    
    .account-user-email { 
      color: #666; 
      font-size: 14px; 
    }
    
    .logout-btn { 
      padding: 10px 20px; 
      background: #ef4444; 
      color: white; 
      border: none; 
      border-radius: 6px; 
      cursor: pointer; 
      font-size: 14px; 
    }
    
    .logout-btn:hover { 
      background: #dc2626; 
    }
    
    @media (max-width: 768px) {
      .account-container { flex-direction: column; }
      .account-sidebar { width: 100%; padding: 16px 0; }
      .account-content { padding: 20px; }
    }
  </style>
</head>
<body>
  <div class="account-container">
    <!-- Sidebar Navigation -->
    <div class="account-sidebar">
      <h3>My Account</h3>
      
      <a href="/account/dashboard" class="account-nav-item <% if (currentPage === 'dashboard') { %>active<% } %>">
        📊 Dashboard
      </a>
      <a href="/account/bookings" class="account-nav-item <% if (currentPage === 'bookings') { %>active<% } %>">
        📦 My Bookings
      </a>
      <a href="/account/reviews" class="account-nav-item <% if (currentPage === 'reviews') { %>active<% } %>">
        ⭐ My Reviews
      </a>
      
      <h3 style="margin-top: 24px;">Account Settings</h3>
      
      <a href="/account/profile" class="account-nav-item <% if (currentPage === 'profile') { %>active<% } %>">
        👤 Edit Profile
      </a>
      <a href="/account/addresses" class="account-nav-item <% if (currentPage === 'addresses') { %>active<% } %>">
        📍 My Addresses
      </a>
      <a href="/account/payments" class="account-nav-item <% if (currentPage === 'payments') { %>active<% } %>">
        💳 Payment Methods
      </a>
      <a href="/account/wallet" class="account-nav-item <% if (currentPage === 'wallet') { %>active<% } %>">
        👛 My Wallet
      </a>
      
      <h3 style="margin-top: 24px;">More</h3>
      
      <a href="/account/coupons" class="account-nav-item <% if (currentPage === 'coupons') { %>active<% } %>">
        🎁 My Coupons
      </a>
      <a href="/account/referral" class="account-nav-item <% if (currentPage === 'referral') { %>active<% } %>">
        🎯 Referral Program
      </a>
      <a href="/account/settings" class="account-nav-item <% if (currentPage === 'settings') { %>active<% } %>">
        ⚙️ Settings
      </a>
    </div>
    
    <!-- Main Content -->
    <div class="account-content">
      <div class="account-header">
        <div class="account-user-info">
          <h2><%= userName || 'Welcome' %></h2>
          <p class="account-user-email"><%= userEmail || '' %></p>
        </div>
        <button class="logout-btn" onclick="logout()">Logout</button>
      </div>
      
      <!-- Page Content will be rendered here -->
      <%- body %>
    </div>
  </div>
  
  <script>
    function logout() {
      if (confirm('Are you sure you want to logout?')) {
        // Clear auth token from localStorage
        localStorage.removeItem('authToken');
        // Redirect to login
        window.location.href = '/login';
      }
    }
  </script>
</body>
</html>
