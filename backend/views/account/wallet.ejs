<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Home Service</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif; background: #f5f5f5; }
    .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
    .dashboard-wrapper { padding: 20px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .dashboard-title { font-size: 24px; margin-bottom: 8px; }
    .dashboard-subtitle { color: #666; margin-bottom: 24px; }
    .wallet-card { padding: 32px; background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white; border-radius: 12px; text-align: center; margin-bottom: 32px; }
    .wallet-label { font-size: 14px; opacity: 0.9; }
    .wallet-amount { font-size: 48px; font-weight: 700; margin: 12px 0; }
    .wallet-actions { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-top: 24px; }
    .btn { padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; transition: all 0.2s; }
    .btn-primary { background: white; color: #3b82f6; font-weight: 600; }
    .btn-primary:hover { background: #f0f9ff; }
    .transactions { margin-top: 32px; }
    .transaction { padding: 12px; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; }
    .transaction:last-child { border-bottom: none; }
    .transaction-desc { color: #666; }
    .transaction-amount { font-weight: 600; }
    .transaction-amount.credit { color: #10b981; }
    .transaction-amount.debit { color: #ef4444; }
  </style>
</head>
<body>
  <div class="container">
    <div class="dashboard-wrapper">
      <h2 class="dashboard-title">My Wallet</h2>
      <p class="dashboard-subtitle">Manage your wallet balance and transactions</p>

      <div class="wallet-card">
        <p class="wallet-label">Current Balance</p>
        <p class="wallet-amount">₹<%= walletBalance.toLocaleString() %></p>
        <div class="wallet-actions">
          <button class="btn btn-primary">Add Money</button>
          <button class="btn btn-primary">Withdraw</button>
        </div>
      </div>

      <div class="transactions">
        <h3 style="margin-bottom: 16px;">Recent Transactions</h3>
        <div class="transaction">
          <div class="transaction-desc">Service Booking - AC Repair</div>
          <span class="transaction-amount debit">-₹699</span>
        </div>
        <div class="transaction">
          <div class="transaction-desc">Refund - Cancelled Booking</div>
          <span class="transaction-amount credit">+₹499</span>
        </div>
        <div class="transaction">
          <div class="transaction-desc">Referral Bonus</div>
          <span class="transaction-amount credit">+₹200</span>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
