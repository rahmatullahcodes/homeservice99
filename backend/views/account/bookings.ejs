<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Home Service</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif; background: #f5f5f5; }
    .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
    .dashboard-wrapper { padding: 20px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .dashboard-title { font-size: 24px; margin-bottom: 8px; }
    .dashboard-subtitle { color: #666; margin-bottom: 24px; }
    .filter-buttons { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
    .filter-btn { padding: 8px 16px; border: 1px solid #ddd; border-radius: 6px; background: white; cursor: pointer; transition: all 0.2s; }
    .filter-btn.active { background: #3b82f6; color: white; border-color: #3b82f6; }
    .booking-list { display: grid; gap: 12px; }
    .booking-card { padding: 16px; border: 1px solid #ddd; border-radius: 8px; display: flex; justify-content: space-between; align-items: center; }
    .booking-info h3 { margin-bottom: 4px; }
    .booking-meta { color: #666; font-size: 14px; }
    .booking-actions { display: flex; gap: 8px; }
    .btn { padding: 8px 16px; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; transition: all 0.2s; }
    .btn-primary { background: #3b82f6; color: white; }
    .btn-primary:hover { background: #2563eb; }
    .btn-danger { background: #ef4444; color: white; }
    .btn-danger:hover { background: #dc2626; }
    .account-badge { padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: 500; display: inline-block; }
    .account-badge.confirmed { background: #dbeafe; color: #1e40af; }
    .account-badge.pending { background: #fef3c7; color: #92400e; }
    .account-badge.completed { background: #dcfce7; color: #166534; }
    .account-badge.cancelled { background: #fee2e2; color: #991b1b; }
  </style>
</head>
<body>
  <div class="container">
    <div class="dashboard-wrapper">
      <h2 class="dashboard-title">My Bookings</h2>
      <p class="dashboard-subtitle">Manage and track your service history</p>

      <!-- FILTER BUTTONS -->
      <div class="filter-buttons">
        <button class="filter-btn <% if (filter === 'All') { %>active<% } %>" onclick="filterBookings('All')">All Bookings</button>
        <button class="filter-btn <% if (filter === 'Confirmed') { %>active<% } %>" onclick="filterBookings('Confirmed')">Confirmed</button>
        <button class="filter-btn <% if (filter === 'Pending') { %>active<% } %>" onclick="filterBookings('Pending')">Pending</button>
        <button class="filter-btn <% if (filter === 'Completed') { %>active<% } %>" onclick="filterBookings('Completed')">Completed</button>
        <button class="filter-btn <% if (filter === 'Cancelled') { %>active<% } %>" onclick="filterBookings('Cancelled')">Cancelled</button>
      </div>

      <!-- BOOKINGS LIST -->
      <div class="booking-list">
        <% if (bookings.length === 0) { %>
          <p style="text-align: center; padding: 40px; color: #999;">No bookings found.</p>
        <% } else { %>
          <% bookings.forEach(booking => { %>
            <div class="booking-card">
              <div class="booking-info">
                <h3><%= booking.serviceName %></h3>
                <p class="booking-meta"><%= new Date(booking.date).toLocaleDateString() %> • ₹<%= booking.price %></p>
                <p style="margin-top: 8px;"><span class="account-badge <%= booking.status.toLowerCase() %>"><%= booking.status %></span></p>
              </div>
              <div class="booking-actions">
                <% if (booking.status === 'Confirmed' || booking.status === 'Pending') { %>
                  <button class="btn btn-danger" onclick="cancelBooking('<%= booking._id %>')">Cancel</button>
                <% } %>
                <a href="/account/bookings/<%= booking._id %>/invoice" class="btn btn-primary">Invoice</a>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>

  <script>
    function filterBookings(status) {
      window.location.href = '/account/bookings?filter=' + status;
    }

    function cancelBooking(bookingId) {
      if (confirm('Are you sure you want to cancel this booking?')) {
        fetch('/account/bookings/' + bookingId + '/cancel', { method: 'POST' })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              alert('Booking cancelled successfully');
              window.location.reload();
            }
          });
      }
    }
  </script>
</body>
</html>
