<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Home Service</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif; background: #f5f5f5; }
    .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
    .dashboard-wrapper { padding: 20px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .dashboard-title { font-size: 24px; margin-bottom: 8px; }
    .dashboard-subtitle { color: #666; margin-bottom: 24px; }
    .referral-card { padding: 24px; background: #f0f9ff; border: 2px solid #bfdbfe; border-radius: 8px; margin-bottom: 24px; }
    .code-box { display: flex; gap: 8px; align-items: center; margin-top: 12px; }
    .code-input { flex: 1; padding: 10px; border: 1px solid #ddd; border-radius: 6px; background: white; font-family: monospace; font-size: 14px; font-weight: 600; }
    .btn { padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; }
    .btn-primary { background: #3b82f6; color: white; }
    .btn-secondary { background: #ddd; color: #333; }
    .referrals-list { display: grid; gap: 12px; }
    .referral-item { padding: 12px; border: 1px solid #ddd; border-radius: 6px; display: flex; justify-content: space-between; align-items: center; }
    .referral-info h3 { margin-bottom: 4px; }
    .referral-meta { color: #666; font-size: 12px; }
    .status-badge { padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: 500; background: #dcfce7; color: #166534; }
  </style>
</head>
<body>
  <div class="container">
    <div class="dashboard-wrapper">
      <h2 class="dashboard-title">Referral Program</h2>
      <p class="dashboard-subtitle">Earn rewards by referring friends</p>

      <div class="referral-card">
        <h3>Your Referral Code</h3>
        <p style="color: #666; margin-top: 4px;">Share this code with friends and earn ₹200 for each successful referral!</p>
        <div class="code-box">
          <input type="text" class="code-input" value="<%= referralCode %>" readonly>
          <button class="btn btn-secondary" onclick="copyCode()">Copy</button>
        </div>
      </div>

      <h3 style="margin-bottom: 16px;">Your Referrals</h3>
      <div class="referrals-list">
        <% if (referrals.length === 0) { %>
          <p style="text-align: center; padding: 20px; color: #999;">No referrals yet. Share your code to start earning!</p>
        <% } else { %>
          <% referrals.forEach(referral => { %>
            <div class="referral-item">
              <div class="referral-info">
                <h3><%= referral.name %></h3>
                <p class="referral-meta"><%= referral.email %> • Joined <%= new Date(referral.joinedAt).toLocaleDateString() %></p>
              </div>
              <div>
                <span class="status-badge"><%= referral.status %></span>
                <p style="margin-top: 4px; font-weight: 600;">Earnings: ₹<%= referral.earnings || 0 %></p>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>

  <script>
    function copyCode() {
      const codeInput = document.querySelector('.code-input');
      codeInput.select();
      document.execCommand('copy');
      alert('Code copied to clipboard!');
    }
  </script>
</body>
</html>
