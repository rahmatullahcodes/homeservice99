<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Home Service</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif; background: #f5f5f5; }
    .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
    .dashboard-wrapper { padding: 20px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .dashboard-title { font-size: 24px; margin-bottom: 8px; }
    .dashboard-subtitle { color: #666; margin-bottom: 24px; }
    .address-list { display: grid; gap: 12px; }
    .address-card { padding: 16px; border: 1px solid #ddd; border-radius: 8px; }
    .btn { padding: 8px 16px; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; }
    .btn-primary { background: #3b82f6; color: white; }
    .btn-danger { background: #ef4444; color: white; }
    .empty-state { text-align: center; padding: 40px; color: #999; }
  </style>
</head>
<body>
  <div class="container">
    <div class="dashboard-wrapper">
      <h2 class="dashboard-title">My Addresses</h2>
      <p class="dashboard-subtitle">Manage your delivery addresses</p>

      <button class="btn btn-primary" style="margin-bottom: 20px;">+ Add New Address</button>

      <div class="address-list">
        <% if (addresses.length === 0) { %>
          <div class="empty-state">
            <p>No addresses saved yet.</p>
          </div>
        <% } else { %>
          <% addresses.forEach(address => { %>
            <div class="address-card">
              <strong><%= address.label || 'Home' %></strong>
              <p><%= address.street %>, <%= address.city %>, <%= address.state %> - <%= address.zipcode %></p>
              <p style="margin-top: 8px;">
                <button class="btn btn-primary">Edit</button>
                <button class="btn btn-danger">Delete</button>
              </p>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
