<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Home Service</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif; background: #f5f5f5; }
    .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
    .dashboard-wrapper { padding: 20px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .dashboard-title { font-size: 24px; margin-bottom: 8px; }
    .dashboard-subtitle { color: #666; margin-bottom: 24px; }
    .coupon-list { display: grid; gap: 12px; }
    .coupon-card { padding: 16px; border: 2px dashed #ddd; border-radius: 8px; background: #fafafa; }
    .coupon-header { display: flex; justify-content: space-between; align-items: start; margin-bottom: 8px; }
    .coupon-code { font-size: 16px; font-weight: 600; font-family: monospace; background: white; padding: 8px 12px; border-radius: 4px; }
    .coupon-desc { color: #666; font-size: 14px; }
    .coupon-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 12px; font-size: 12px; color: #999; }
    .badge { padding: 4px 8px; border-radius: 4px; background: #dcfce7; color: #166534; font-weight: 500; }
    .empty-state { text-align: center; padding: 40px; color: #999; }
  </style>
</head>
<body>
  <div class="container">
    <div class="dashboard-wrapper">
      <h2 class="dashboard-title">My Coupons</h2>
      <p class="dashboard-subtitle">View your available discount coupons</p>

      <div class="coupon-list">
        <% if (coupons.length === 0) { %>
          <div class="empty-state">
            <p>No coupons available yet.</p>
          </div>
        <% } else { %>
          <% coupons.forEach(coupon => { %>
            <div class="coupon-card">
              <div class="coupon-header">
                <div>
                  <div class="coupon-code"><%= coupon.code %></div>
                  <p class="coupon-desc"><%= coupon.description %></p>
                </div>
                <span class="badge"><%= coupon.discount %>% OFF</span>
              </div>
              <div class="coupon-footer">
                <span>Valid till: <%= coupon.expiryDate %></span>
                <button style="padding: 6px 12px; background: #3b82f6; color: white; border: none; border-radius: 4px; cursor: pointer;">Apply</button>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
