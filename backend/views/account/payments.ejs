<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Home Service</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif; background: #f5f5f5; }
    .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
    .dashboard-wrapper { padding: 20px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .dashboard-title { font-size: 24px; margin-bottom: 8px; }
    .dashboard-subtitle { color: #666; margin-bottom: 24px; }
    .payment-list { display: grid; gap: 12px; }
    .payment-card { padding: 16px; border: 1px solid #ddd; border-radius: 8px; display: flex; justify-content: space-between; align-items: center; }
    .payment-info h3 { margin-bottom: 4px; }
    .payment-meta { color: #666; font-size: 14px; }
    .btn { padding: 8px 16px; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; }
    .btn-primary { background: #3b82f6; color: white; }
    .btn-danger { background: #ef4444; color: white; }
    .empty-state { text-align: center; padding: 40px; color: #999; }
  </style>
</head>
<body>
  <div class="container">
    <div class="dashboard-wrapper">
      <h2 class="dashboard-title">Payment Methods</h2>
      <p class="dashboard-subtitle">Manage your saved payment methods</p>

      <button class="btn btn-primary" style="margin-bottom: 20px;">+ Add Payment Method</button>

      <div class="payment-list">
        <% if (paymentMethods.length === 0) { %>
          <div class="empty-state">
            <p>No payment methods saved yet.</p>
          </div>
        <% } else { %>
          <% paymentMethods.forEach(method => { %>
            <div class="payment-card">
              <div class="payment-info">
                <h3><%= method.type %> - **** <%= method.lastFour %></h3>
                <p class="payment-meta">Expires: <%= method.expiryMonth %>/<%= method.expiryYear %></p>
              </div>
              <div>
                <% if (method.default) { %>
                  <span style="color: #10b981; font-weight: 500; margin-right: 12px;">✓ Default</span>
                <% } else { %>
                  <button class="btn btn-primary">Set as Default</button>
                <% } %>
                <button class="btn btn-danger">Delete</button>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
