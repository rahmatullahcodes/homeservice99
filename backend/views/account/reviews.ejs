<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Home Service</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif; background: #f5f5f5; }
    .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
    .dashboard-wrapper { padding: 20px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .dashboard-title { font-size: 24px; margin-bottom: 8px; }
    .dashboard-subtitle { color: #666; margin-bottom: 24px; }
    .reviews-list { display: grid; gap: 16px; }
    .review-card { padding: 20px; border: 1px solid #ddd; border-radius: 8px; }
    .review-header { display: flex; justify-content: space-between; align-items: start; margin-bottom: 12px; }
    .review-title { font-size: 16px; font-weight: 600; }
    .review-rating { display: flex; gap: 2px; }
    .star { font-size: 16px; color: #f59e0b; }
    .review-date { font-size: 12px; color: #999; margin-top: 4px; }
    .review-text { color: #666; line-height: 1.6; margin: 12px 0; }
    .review-meta { font-size: 12px; color: #999; }
  </style>
</head>
<body>
  <div class="container">
    <div class="dashboard-wrapper">
      <h2 class="dashboard-title">My Reviews</h2>
      <p class="dashboard-subtitle">Manage your service reviews and ratings</p>

      <div class="reviews-list">
        <% if (bookings.length === 0) { %>
          <p style="text-align: center; padding: 40px; color: #999;">
            No reviews yet. Complete a booking and add a review!
          </p>
        <% } else { %>
          <% bookings.forEach(booking => { %>
            <div class="review-card">
              <div class="review-header">
                <div>
                  <div class="review-title"><%= booking.serviceName %></div>
                  <div class="review-date"><%= new Date(booking.createdAt).toLocaleDateString() %></div>
                </div>
                <div class="review-rating">
                  <% for (let i = 0; i < (booking.rating || 5); i++) { %>
                    <span class="star">⭐</span>
                  <% } %>
                </div>
              </div>
              <p class="review-text"><%= booking.reviewText || 'No review text' %></p>
              <p class="review-meta">
                Service: <%= booking.serviceName %> • 
                Vendor: <%= booking.vendorName || 'N/A' %>
              </p>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
