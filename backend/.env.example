# Backend Environment Variables
# Copy this to backend/.env and fill in your values

# Port
PORT=5000

# Database
MONGO_URI=mongodb://localhost:27017/homeservice99

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Booking acceptance coin deduction (charged to vendor wallet on accept)
BOOKING_ACCEPT_COINS=5

# Cloudinary (for image uploads - optional)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Node Environment
NODE_ENV=development

# Razorpay (for online checkout and wallet top-up)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
